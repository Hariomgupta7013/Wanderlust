<% layout("/layouts/boilerplate") %>

<div class="create-page-wrapper d-flex align-items-center justify-content-center py-5">
  <div class="create-card shadow-lg p-5 rounded-4">
    <h3 class="text-center mb-4 fw-bold text-gradient">Create a New Listing</h3>

    <form
      method="POST"
      action="/listings"
      novalidate
      class="needs-validation"
      enctype="multipart/form-data"
    >
      <!-- Title -->
      <div class="mb-3">
        <label for="title" class="form-label fw-semibold">Title</label>
        <input
          name="listing[title]"
          type="text"
          placeholder="Enter title"
          class="form-control form-control-lg"
          required
        />
        <div class="valid-feedback">Title looks good!</div>
      </div>

      <!-- Description -->
      <div class="mb-3">
        <label for="description" class="form-label fw-semibold">Description</label>
        <textarea
          name="listing[description]"
          class="form-control"
          rows="4"
          placeholder="Write a short description..."
          required
        ></textarea>
        <div class="invalid-feedback">Please enter a short description</div>
      </div>

      <!-- Image Upload -->
      <div class="mb-3">
        <label for="image" class="form-label fw-semibold">Upload Listing Image</label>
        <input
          id="image"
          name="listing[image]"
          type="file"
          class="form-control"
          required
        />
        <div class="preview-container text-center mt-3 d-none">
          <img
            id="previewImage"
            class="img-fluid rounded-3 shadow-sm"
            style="max-height: 250px; object-fit: cover;"
            alt="Preview"
          />
        </div>
      </div>

      <!-- Price & Country -->
      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label fw-semibold">Price</label>
          <input
            name="listing[price]"
            type="number"
            placeholder="12000"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Price should be valid</div>
        </div>

        <div class="mb-3 col-md-8">
          <label for="country" class="form-label fw-semibold">Country</label>
          <input
            name="listing[country]"
            type="text"
            placeholder="India"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Country name should be valid</div>
        </div>
      </div>

      <!-- Location -->
      <div class="mb-3">
        <label for="location" class="form-label fw-semibold">Location</label>
        <input
          name="listing[location]"
          type="text"
          placeholder="Jaipur, Rajasthan"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Location should be valid</div>
      </div>

      <!-- Button -->
      <div class="text-center mt-4">
        <button class="btn btn-gradient btn-lg px-5 py-2">
          <i class="fa-solid fa-circle-plus me-2"></i>Add Listing
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Image Preview Script -->
<script>
  const imageInput = document.getElementById("image");
  const previewContainer = document.querySelector(".preview-container");
  const previewImage = document.getElementById("previewImage");

  imageInput.addEventListener("change", (event) => {
    const file = event.target.files[0];
    if (file) {
      previewContainer.classList.remove("d-none");
      previewImage.src = URL.createObjectURL(file);
    } else {
      previewContainer.classList.add("d-none");
      previewImage.src = "";
    }
  });
</script>

<style>
  /* Wrapper to center everything vertically */
  .create-page-wrapper {
    min-height: 100vh;
    background: linear-gradient(135deg, #f8f9fa, #ececec);
  }

  /* Form Card */
  .create-card {
    width: 100%;
    max-width: 700px;
    background: #ffffff;
    border: 1px solid #eaeaea;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .create-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
  }

  /* Gradient Text */
  .text-gradient {
    background: linear-gradient(90deg, #ff4b2b, #ff416c);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Button */
  .btn-gradient {
    background: linear-gradient(90deg, #ff4b2b, #ff416c);
    border: none;
    color: white;
    border-radius: 30px;
    transition: 0.3s;
  }

  .btn-gradient:hover {
    transform: translateY(-3px);
    box-shadow: 0px 8px 20px rgba(255, 65, 108, 0.4);
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .create-card {
      padding: 25px;
    }
    .btn-gradient {
      width: 100%;
    }
    .text-gradient {
      font-size: 1.5rem;
    }
  }
</style>
