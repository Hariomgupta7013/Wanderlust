<% layout("/layouts/boilerplate") %>

<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="container my-5">
  <!-- Title -->
  <div class="text-center mb-4">
    <h2 class="fw-bold text-dark"><%= listing.title %></h2>
  </div>

  <!-- Listing Card -->
  <div class="card mx-auto border-0 shadow-lg rounded-4 overflow-hidden show-card">
    <img
      src="<%= listing.image.url %>"
      class="card-img-top show-img"
      alt="listing_image"
    />
    <div class="card-body text-center px-4">
      <p class="text-secondary mb-2">Hosted by <b><%= listing.owner.username %></b></p>
      <p class="lead text-muted mb-2"><%= listing.description %></p>
      <p class="fw-semibold fs-5 mb-1 text-success">
        ₹<%= listing.price.toLocaleString("en-IN") %> / night
      </p>
      <p class="text-secondary small mb-1"><i class="bi bi-geo-alt-fill"></i> <%= listing.location %></p>
      <p class="text-muted small"><%= listing.country %></p>
    </div>
  </div>

  <!-- Edit / Delete Buttons -->
  <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
  <div class="text-center mt-4">
    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark px-4 me-2 rounded-pill shadow-sm">Edit</a>
    <form
      method="POST"
      action="/listings/<%= listing._id %>?_method=DELETE"
      class="d-inline"
    >
      <button class="btn btn-danger px-4 rounded-pill shadow-sm">Delete</button>
    </form>
  </div>
  <% } %>

  <!-- Review Section -->
  <div class="mt-5">
    <% if(currUser) { %>
    <hr />
    <h4 class="fw-bold mb-3 text-center">Leave a Review</h4>
    <form
      action="/listings/<%= listing._id %>/reviews"
      method="POST"
      novalidate
      class="needs-validation mx-auto"
      style="max-width: 600px"
    >
      <div class="mb-3">
        <label for="rating" class="form-label">Rating</label>
        <fieldset class="starability-slot">
          <input type="radio" id="first-rate1" name="review[rating]" value="1" />
          <label for="first-rate1">1 star</label>
          <input type="radio" id="first-rate2" name="review[rating]" value="2" />
          <label for="first-rate2">2 stars</label>
          <input type="radio" id="first-rate3" name="review[rating]" value="3" />
          <label for="first-rate3">3 stars</label>
          <input type="radio" id="first-rate4" name="review[rating]" value="4" />
          <label for="first-rate4">4 stars</label>
          <input type="radio" id="first-rate5" name="review[rating]" value="5" />
          <label for="first-rate5">5 stars</label>
        </fieldset>
      </div>

      <div class="mb-3">
        <label for="comment" class="form-label">Comment</label>
        <textarea
          name="review[comment]"
          id="comment"
          cols="30"
          rows="5"
          class="form-control rounded-3"
          required
        ></textarea>
        <div class="invalid-feedback">
          Please provide some feedback for this place.
        </div>
      </div>

      <div class="text-center">
        <button class="btn btn-outline-dark px-5 rounded-pill shadow-sm">Submit</button>
      </div>
    </form>
    <% } %>

    <hr />

    <!-- All Reviews -->
    <% if(listing.reviews.length > 0) { %>
    <div class="text-center mb-3">
      <h4 class="fw-bold">Guest Reviews</h4>
    </div>

    <div class="row justify-content-center">
      <% for(review of listing.reviews) { %>
      <div class="col-12 col-md-6 col-lg-4 mb-4 d-flex align-items-stretch">
        <div class="card w-100 border-0 shadow-sm rounded-4">
          <div class="card-body">
            <h6 class="card-title mb-1">@<%= review.author.username %></h6>
            <p class="starability-result card-text mb-2" data-rating="<%= review.rating %>"></p>
            <p class="card-text"><%= review.comment %></p>
            <p class="text-muted small mb-2"><%= review.createdAt.toDateString() %></p>

            <form
              action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
              method="POST"
            >
              <button class="btn btn-sm btn-outline-danger rounded-pill">Delete</button>
            </form>
          </div>
        </div>
      </div>
      <% } %>
    </div>
    <% } %>
  </div>

  <!-- Map Section -->
  <div class="mt-5">
    <h4 class="fw-bold mb-3 text-center">Where you'll be</h4>
    <div id="map" class="rounded-4 shadow-sm"></div>
  </div>
</div>

<script src="/js/map.js"></script>

<style>
  /* ------- General Style ------- */
  .show-card {
    max-width: 800px;
  }

  .show-img {
    width: 100%;
    height: 400px;
    object-fit: cover;
  }

  #map {
    width: 100%;
    height: 350px;
  }

  /* ------- Responsive Tweaks ------- */
  @media (max-width: 768px) {
    .show-img {
      height: 260px;
    }
    h2 {
      font-size: 1.4rem;
    }
    .btn {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 576px) {
    #map {
      height: 250px;
    }
    .lead {
      font-size: 0.9rem;
    }
  }
</style>
