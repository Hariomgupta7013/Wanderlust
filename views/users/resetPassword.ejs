<form action="/reset-password/<%= token %>" method="POST">
  <input type="password" name="password" placeholder="New Password" class="form-control" required>
  <input type="password" name="confirmPassword" placeholder="Confirm Password" class="form-control mt-2" required>
  <button class="btn btn-success w-100 mt-3">Reset Password</button>
</form>
