<% layout("/layouts/boilerplate") %>

    <div class="row mt-3">
        <h1 class="col-6 offset-3">SingUp on Wanderlust</h1>
        <div class="col-6 offset-3">
            <form action="/singup" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input id="username" name="username" type="text" placeholder="enter your username"
                        class="form-control" required>
                    <div class="valid-feedback">Looks good!</div>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input id="email" name="email" type="email" placeholder="enter your email" class="form-control" required>
                </div>
                 <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input id="passwore" name="password" type="password" placeholder="enter your password" class="form-control" required>
                </div>
                <button class="btn btn-success">SingUp</button>
            </form>
        </div>
    </div>